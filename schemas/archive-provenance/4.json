{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.atrekos.com/schemas/archive-provenance/4.json",
  "title": "Atrekos archive provenance",
  "description": "`provenance.json` of an assessment archive: the only file that carries internal identifiers (with `localKeys`, the map from each local key the rest of the archive uses to its identifier), the approval, the snapshot generations and `pdfsWithDatabaseId`, the frozen PDFs that print the assessment id. Deleting it leaves the rest of the archive verifiable.",
  "type": "object",
  "properties": {
    "localKeys": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Each local key the archive uses (`organisation`, `asset-<n>`, `interface-<n>`, `revision-<number>`) and the identifier it stands for."
    },
    "pdfsWithDatabaseId": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The archive paths of the frozen PDFs that print the assessment id given in `assessmentId` (reports frozen before #1729 did); they are copied as frozen. Empty when no PDF in the archive prints it."
    },
    "assessmentId": {
      "type": "string"
    },
    "orgId": {
      "type": "string"
    },
    "productId": {
      "type": [
        "string",
        "null"
      ]
    },
    "packRevisionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "packRevisionLabel": {
      "type": [
        "string",
        "null"
      ]
    },
    "cloneProvenance": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "sourceAssessmentId": {
              "type": "string"
            },
            "pinning": {
              "type": "string",
              "enum": [
                "source",
                "latest"
              ]
            },
            "diffSummary": {
              "anyOf": [
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {},
                  "description": "Internal clone bookkeeping; its shape is not part of the public contract."
                },
                {
                  "type": "null"
                }
              ]
            },
            "migrationLog": {
              "anyOf": [
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {},
                  "description": "Internal clone bookkeeping; its shape is not part of the public contract."
                },
                {
                  "type": "null"
                }
              ]
            },
            "clonedAt": {
              "type": "string"
            }
          },
          "required": [
            "sourceAssessmentId",
            "pinning",
            "diffSummary",
            "migrationLog",
            "clonedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "pinnedVersionIds": {
      "type": "object",
      "properties": {
        "modelVersionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "questionsCatalogVersionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "dsCatalogVersionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "stepsCatalogVersionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "assumptionsCatalogVersionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "cmsCatalogVersionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "modelVersionId",
        "questionsCatalogVersionId",
        "dsCatalogVersionId",
        "stepsCatalogVersionId",
        "assumptionsCatalogVersionId",
        "cmsCatalogVersionId"
      ],
      "additionalProperties": false
    },
    "evidenceStatus": {
      "type": "string",
      "enum": [
        "approved",
        "working-copy"
      ]
    },
    "approval": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "approverName": {
              "type": "string"
            },
            "approverRole": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            },
            "approvedAt": {
              "type": "string"
            },
            "inputHash": {
              "type": "string"
            }
          },
          "required": [
            "approverName",
            "approverRole",
            "rationale",
            "approvedAt",
            "inputHash"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshotGenerations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "generation": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "completedAt": {
            "type": "string"
          },
          "snapshotIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "generation",
          "completedAt",
          "snapshotIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "localKeys",
    "pdfsWithDatabaseId",
    "assessmentId",
    "orgId",
    "productId",
    "packRevisionId",
    "cloneProvenance",
    "pinnedVersionIds",
    "evidenceStatus",
    "approval",
    "snapshotGenerations"
  ],
  "additionalProperties": false
}
